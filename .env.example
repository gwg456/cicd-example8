# Prefect CI/CD 示例项目环境变量配置
# 复制此文件为 .env 并根据实际情况修改配置值

# =============================================================================
# Prefect 配置
# =============================================================================

# Prefect API URL - Prefect服务器的API地址
# 本地开发: http://localhost:4200/api
# 远程服务器: http://your-prefect-server:4200/api
PREFECT_API_URL=http://172.31.0.55:4200/api

# 工作池名称 - 用于执行流程的工作池
WORK_POOL_NAME=my-docker-pool2

# =============================================================================
# Docker 配置
# =============================================================================

# Docker镜像仓库地址
IMAGE_REPO=ghcr.io/samples28/cicd-example

# Docker镜像标签（可选，如果不设置会自动生成）
IMAGE_TAG=v202501010000

# =============================================================================
# 应用配置
# =============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 运行环境: development, staging, production
ENVIRONMENT=development

# 部署模式: true=部署模式, false=执行模式
DEPLOY_MODE=false

# =============================================================================
# 调度配置
# =============================================================================

# 调度间隔（秒）- 流程执行的间隔时间
SCHEDULE_INTERVAL=3600

# =============================================================================
# 超时配置
# =============================================================================

# API超时时间（秒）
API_TIMEOUT=300

# 部署超时时间（秒）
DEPLOYMENT_TIMEOUT=60

# =============================================================================
# 安全注意事项
# =============================================================================

# 1. 不要将包含敏感信息的 .env 文件提交到版本控制系统
# 2. 在生产环境中使用环境变量或密钥管理服务
# 3. 定期轮换API密钥和访问令牌
# 4. 使用最小权限原则配置访问权限

# =============================================================================
# 使用说明
# =============================================================================

# 本地开发示例:
# PREFECT_API_URL=http://localhost:4200/api
# DEPLOY_MODE=false
# LOG_LEVEL=DEBUG

# 生产环境示例:
# PREFECT_API_URL=https://your-production-prefect.com/api
# DEPLOY_MODE=true
# LOG_LEVEL=INFO
# ENVIRONMENT=production